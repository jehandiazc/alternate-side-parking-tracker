# ─────────────────────────────────────────────────────────────────────────────
# ParkShare environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# See docs/SELF_HOSTING.md for a step-by-step guide to obtaining each one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only — used by the cron route to send push notifications. Keep secret;
# never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Map tiles (MapTiler) ─────────────────────────────────────────────────────
# Free key at https://www.maptiler.com/ (uses the "Aquarelle" style).
# IMPORTANT: add your origins to the key's "Allowed origins (HTTP referrers)" —
# e.g. http://localhost:3000 for dev and your deploy domain — or the map shows
# an "Invalid key" tile. If unset, the app falls back to keyless CARTO tiles.
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key

# ── NYC Open Data (street cleaning schedules) ────────────────────────────────
# Free app token at https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=your_app_token

# ── Web Push (move reminders) ────────────────────────────────────────────────
# Generate a VAPID keypair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your@email.com

# ── Cron (notification scheduler) ────────────────────────────────────────────
# Shared secret the GitHub Actions cron sends as a Bearer token to
# /api/cron/notify. In your repo settings, add CRON_SECRET (this value) and
# APP_URL (your deployed base URL) as Actions secrets.
# Generate a value with: openssl rand -hex 32
CRON_SECRET=your_cron_secret
